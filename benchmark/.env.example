# ══════════════════════════════════════════════════════════════
# Kermit XRAG-Benchmark – Konfiguration
# ══════════════════════════════════════════════════════════════
# cp benchmark/.env.example benchmark/.env
# Jeder Wert laesst sich auch als Umgebungsvariable oder CLI-Flag setzen.

# ── Kermit-Endpunkte (make dev: Ports auf localhost) ─────────
# Frontend: Login + Upload ueber /api/ingest (voller Ingest-Pfad).
# Leer → automatisch: localhost:5173 (make dev, Vite) oder localhost:3000 (make up)
KERMIT_FRONTEND_URL=
KERMIT_EVALUATION_URL=http://localhost:8005
KERMIT_VECTORDB_URL=http://localhost:8004
# Nur fuer `make benchmark-clean` (gespeicherte Originaldateien loeschen)
KERMIT_CLEANING_URL=http://localhost:8001
# Admin-Login fuers Frontend. Leer → ADMIN_USERNAME/ADMIN_PASSWORD aus ../.env
KERMIT_USERNAME=
KERMIT_PASSWORD=

# ── Judge-LLM ────────────────────────────────────────────────
# Bewertet die Antworten gegen die Gold-Antwort. Bewusst getrennt vom
# Kermit-Modell, damit das Modell nicht seine eigenen Antworten benotet.
# BENCH_JUDGE_MODEL leer → nur Kennzahlen ohne LLM.
#
# openai – OpenAI oder kompatibel (DeepSeek, LiteLLM, vLLM …). Base-URL ohne
#          Endpunkt, z.B. https://api.openai.com/v1 oder https://api.deepseek.com;
#          /chat/completions wird angehaengt. Key als Bearer-Token.
# ollama – native Ollama-API (/api/chat). Key optional, als X-API-Key
#          (Ollama-Gateway wie bei OLLAMA_API_KEY in ../.env).
BENCH_JUDGE_PROVIDER=openai
# Leer → https://api.openai.com/v1 bzw. http://localhost:11434
BENCH_JUDGE_BASE_URL=
BENCH_JUDGE_API_KEY=
BENCH_JUDGE_MODEL=gpt-4o-mini
#
# Beispiel Ollama:
#   BENCH_JUDGE_PROVIDER=ollama
#   BENCH_JUDGE_BASE_URL=http://<ollama-host>:11434
#   BENCH_JUDGE_MODEL=qwen2.5:32b
# Kontextfenster je Ollama-Request (Gateway verlangt es, siehe OLLAMA_NUM_CTX)
BENCH_JUDGE_NUM_CTX=32768
BENCH_JUDGE_TIMEOUT=120
BENCH_JUDGE_CONCURRENCY=4

# ── Stichprobe ───────────────────────────────────────────────
# Split: test (Bewertung) oder dev (Tuning – das Testset nicht ueberanpassen)
XRAG_SPLIT=test
# DE-Fragen mit englischen Artikeln (je als DE- und EN-Frage gestellt)
BENCH_MONO=100
# DE-Fragen mit gemischt deutsch/englischen Artikeln
BENCH_MULTI=50
# Fragen, deren Artikel NICHT indexiert werden → Ablehnung erwartet
BENCH_NEGATIVE=10
# Ablenk-Artikel pro Frage im Index (leer = alle, meist 6). Weniger = weniger
# Upload; die Artikel der anderen Fragen bleiben als Ablenker im Index.
BENCH_DISTRACTORS=
# Welche Varianten gestellt werden: de, en, multi, neg
BENCH_VARIANTS=de,en,multi,neg
BENCH_SEED=42

# ── Ablauf ───────────────────────────────────────────────────
BENCH_USE_CASE=xrag_bench
BENCH_INGEST_CONCURRENCY=4
# Teilt sich das LLM mit dem Chat; hoeher = schneller, aber Latenzwerte steigen.
BENCH_QUERY_CONCURRENCY=2
BENCH_QUERY_TIMEOUT=900
