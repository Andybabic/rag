# syntax=docker/dockerfile:1.7
#
# The skill sandbox service. It is the only container that gets the Docker
# socket, and it needs the Docker *client* to use it.
#
# It runs as root on purpose. Access to /var/run/docker.sock is already
# root-equivalent on the host, so dropping to an unprivileged user inside this
# container would buy nothing while making the socket's group id a per-host
# deployment problem. The security boundary is the runner container this
# service starts (see services/sandbox/runner/Dockerfile), not this one — keep
# this service off any public network and give it only the evaluation service
# as a client.
FROM python:3.11-slim

WORKDIR /app

# docker-cli only: no daemon, no compose, no buildx. It talks to the host's
# daemon through the mounted socket.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg \
        -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] \
https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
        > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*

COPY shared/ /shared
RUN --mount=type=cache,target=/root/.cache/pip pip install -e /shared

COPY services/sandbox/requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip pip install -r requirements.txt

COPY services/sandbox/ .

EXPOSE 8007 8888

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8007"]
