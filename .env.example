# ══════════════════════════════════════════════════════════════
# RAG Platform – Environment Variables
# ══════════════════════════════════════════════════════════════
#
# Fuer lokale Entwicklung:  cp .env.example .env.dev
# Fuer Produktion:          cp .env.example .env  (pro Server)
#
# Drei Server:
#   Server A (Core)      – docker-compose.core.yml
#   Server B (Inference)  – docker-compose.inference.yml
#   Server C (Frontend)   – docker-compose.frontend.yml

# ── Server-uebergreifende URLs ────────────────────────────────
# Passen Sie die IPs/Hostnamen an Ihre Infrastruktur an.
# Im lokalen Entwicklungsbetrieb (docker-compose.dev.yml) werden
# die Docker-Service-Namen verwendet.

# Server A Services
CLEANING_SERVICE_URL=http://cleaning:8001
DATA_STRUCTURE_SERVICE_URL=http://data_structure:8002
EMBEDDING_SERVICE_URL=http://embedding:8003
VECTORDB_SERVICE_URL=http://vectordb:8004

# Server B Services
EVALUATION_SERVICE_URL=http://evaluation:8005

# Server C Services
FRONTEND_URL=http://frontend:3000
# Oeffentliche Frontend-URL im Browser (Pflicht fuer Login/CSRF hinter Proxy/Coolify).
# Keine ${…}-Syntax – nur die exakte URL, die Nutzer im Browser sehen.
# ORIGIN=https://kermit.inference.media.fhstp.ac.at
# ORIGIN=http://localhost:3000

# ── Persistente Daten (docker-compose.yml) ───────────────────
# Named Volumes in docker-compose.yml – kein Host-Pfad noetig.
# Coolify: KERMIT_DATA_DIR nicht setzen; beim Loeschen „Keep Volumes“ waehlen.
#   kermit_postgres   – PostgreSQL
#   kermit_qdrant     – Vektoren
#   kermit_documents  – hochgeladene Originaldateien + Bilder
#   kermit_hf_cache   – Reranker-Modell (HuggingFace)
#   kermit_ollama     – nur bei Profil local-ollama

# ── Host-Port-Bindings (Single-Server / make up) ─────────────
# false → nur internes Docker-Netzwerk (Coolify/Reverse-Proxy)
# true  → Services auf localhost erreichbar (Ports unten)
BIND_PORTS=false
# Host-Ports (nur wenn BIND_PORTS=true). Container-Ports bleiben gleich.
CLEANING_PORT=8001
DATA_STRUCTURE_PORT=8002
EMBEDDING_PORT=8003
VECTORDB_PORT=8004
EVALUATION_PORT=8005
FRONTEND_PORT=3000
# OLLAMA_PORT=11434   # nur bei Profil local-ollama

# ── LLM Provider Pipeline ────────────────────────────────────
# Pro Rolle einzeln umschaltbar: ollama | openai
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
VISION_PROVIDER=ollama
# Read-Timeout (Sekunden) pro Vision-Aufruf (Alt-Text zu Bildern). Langsame
# Vision-Modelle brauchen leicht >1 Min pro Bild; ein zu kurzer Timeout liess
# frueher einen ganzen Dokument-Import an EINEM Bild abbrechen. Fehlgeschlagene
# Vision-Aufrufe brechen den Import jetzt nicht mehr ab (Bild ohne Beschreibung).
VISION_TIMEOUT=180

# ── Ollama (LLM + Embeddings) ────────────────────────────────
# Lokal auf Server B. Server A braucht Zugriff fuer Embeddings.
# OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
# Optional: API-Key fuer Ollama API Key Manager Gateway (X-API-Key header).
# Leer lassen wenn direkt gegen ein nacktes Ollama gesprochen wird.
OLLAMA_API_KEY=
# Context-Window-Groesse (Tokens), die in jeden Ollama-Request gesendet wird.
# Pflicht beim GIM-Gateway, sonst Fehler.
OLLAMA_NUM_CTX=32768

# ── OpenAI (oder OpenAI-kompatibel: Azure, vLLM, LiteLLM, ...) ─
# Wird nur genutzt wenn ein *_PROVIDER auf "openai" steht.
OPENAI_BASE_URL=http://jrz-spark-01.media.lab:4000/
OPENAI_API_KEY=
# Optional: eigener OpenAI-kompatibler Endpoint + Token NUR fuer Embeddings,
# falls die Embeddings auf einem anderen Server laufen als Chat/Vision. Wenn
# leer, werden OPENAI_BASE_URL / OPENAI_API_KEY verwendet.
EMBEDDING_OPENAI_BASE_URL=
EMBEDDING_OPENAI_API_KEY=

# ── Embedding-Modell ─────────────────────────────────────────
# Modellname in Ollama fuer Vektor-Embeddings.
EMBEDDING_MODEL=qwen3-embedding:0.6b
# Dimensionalitaet der Vektoren (muss zum Modell passen).
EMBEDDING_DIMENSION=768
# Max. Chunks pro Embed-Batch.
EMBED_BATCH_SIZE=50

# ── LLM-Modell ───────────────────────────────────────────────
# Lese-Timeout (Sekunden) fuer Chat-Aufrufe. Faellt ein Modell in eine
# Wiederholungsschleife, generiert es bis zum Abbruch — dieser Wert ist also
# der Worst Case eines einzelnen LLM-Calls. Frueher fest auf 300s verdrahtet.
CHAT_TIMEOUT=120
# Chain-of-Thought / Thinking-Tokens (Nemotron, Qwen3, …). Standard aus.
# THINKING=true sendet chat_template_kwargs.enable_thinking=true (OpenAI/vLLM)
# bzw. think=true (Ollama).
THINKING=false
# Modellname in Ollama fuer Textgenerierung (ReAct-Agent).
# Hinweis: Wenn im Chat Bilder mitgeschickt werden, verarbeitet dieses Modell
# sie im selben Prompt -> es MUSS dann vision-faehig sein (z.B. Ollama:
# llava, llama3.2-vision; OpenAI-kompatibel: Pixtral). Ein reines Textmodell
# (z.B. ministral, qwen2.5) ignoriert angehaengte Bilder.
LLM_MODEL=qwen2.5:14b

# ── Qdrant (Vektor-Datenbank) ────────────────────────────────
# Laeuft auf Server A, intern erreichbar ueber Docker-Netzwerk.
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ── PostgreSQL ───────────────────────────────────────────────
# Laeuft auf Server C.
POSTGRES_HOST=postgres
# Host-Port nach aussen (Docker-Mapping: ${POSTGRES_PORT}:5432).
# Wenn 5432 auf dem Server schon belegt ist (z.B. system-postgresql),
# hier einen freien Port setzen, z.B. 5433. DATABASE_URL unten unveraendert
# lassen (@postgres:5432 = interner Container-Port).
POSTGRES_PORT=5433
POSTGRES_DB=ragplatform
POSTGRES_USER=rag
POSTGRES_PASSWORD=changeme
# Vollstaendiger Connection-String (wird vom Evaluation-Service verwendet).
DATABASE_URL=postgresql://rag:changeme@postgres:5432/ragplatform

# ── Data Structure ───────────────────────────────────────────
# Chunk-Groesse und -Ueberlappung in TOKENS (nicht Zeichen!).
# LlamaIndex SentenceSplitter zaehlt Tokens; fuer deutschen Text gilt
# grob: 1 Token ≈ 3–4 Zeichen, also 256 Tokens ≈ 1000 Zeichen.
# 256/32 ist auf eine semantische Einheit pro Chunk getuned – kleine
# Paragraf-Sections (z.B. § 11 mit ~300 Tokens) erhalten so eigene
# Chunks statt von Nachbar-Sections verschluckt zu werden.
DEFAULT_CHUNK_SIZE=256
DEFAULT_CHUNK_OVERLAP=32

# ── Cleaning ─────────────────────────────────────────────────
# MinerU fuer PDF-Parsing verwenden (true/false).
# WICHTIG: Auf "true" setzen, wenn die Dokumente gescannte/bildbasierte
# PDFs oder Tabellen enthalten (z.B. Vorschriften-PDFs). PyMuPDF (false)
# kann aus Scans keinen Text lesen -> es entsteht ein leerer, nicht
# durchsuchbarer Index. Bei USE_MINERU=true gibt es KEINEN PyMuPDF-
# Fallback mehr; schlaegt MinerU fehl, bricht der Ingest mit klarem
# Fehler ab (statt still einen leeren Index zu bauen).
USE_MINERU=true
MINERU_API_URL=http://mineru:8000
# Grosse PDFs sprengen MinerU in einem einzigen Aufruf (Timeout / OOM) und der
# Import bricht ab. Ab mehr als dieser Seitenzahl wird das PDF in Teile zu je so
# vielen Seiten zerlegt, einzeln geparst und wieder zu EINEM Dokument
# zusammengefuehrt (Seitenzahlen/Anker/Bilder werden korrekt umnummeriert).
# 0 = Aufteilen deaktiviert.
MINERU_MAX_PAGES_PER_CHUNK=50
# Debug-Modus: legt zu jedem MinerU-Bild eine <image_id>.txt im selben
# Ordner ab, mit Vision-Beschreibung + dem an die Vision gesendeten
# Kontext (Text davor/danach). Nur zum Testen/Tuning.
DEBUG_IMAGE_CAPTIONS=false

# ── Agent ────────────────────────────────────────────────────
# Max. Schritte im ReAct-Loop bevor der Agent aufgibt.
AGENT_MAX_STEPS=5
# Max. Zeichen im Session-Gedaechtnis.
MEMORY_MAX_CHARS=4000
# Zeitbudget (Sekunden) pro Sub-Agent im Manager-Fan-out. Der Fan-out ist ein
# gather, deshalb bestimmt ohne diese Grenze der langsamste Spezialist die
# Dauer der ganzen Phase — auch wenn er haengt. Grosszuegig genug, dass ein
# gesunder Mehrschritt-Agent nie abgeschnitten wird.
SUBAGENT_TIMEOUT_S=150

# ── Verschluesselung gespeicherter Secrets ──────────────────
# Master-Key fuer at-rest-Verschluesselung von API-Keys, die ueber
# das Frontend pro Use Case in der DB hinterlegt werden.
# Generieren mit:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Falls leer: API-Keys koennen nur via .env gesetzt werden, nicht ueber das UI.
CONFIG_MASTER_KEY=

# ── Authentifizierung ────────────────────────────────────────
# Initialer Admin: wird beim Start angelegt, wenn die users-Tabelle leer ist.
# Danach koennen weitere User ueber das Dashboard angelegt werden. Nach dem
# ersten Start koennen diese Werte entfernt werden (Seeding ist idempotent).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Secret zum Signieren der Session-Cookies (HMAC). MUSS gesetzt werden.
# Generieren mit:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# ── Oeffentliche Pipeline-API (/api/v1) ──────────────────────
# Die Pipeline ist zusaetzlich per HTTP-API nutzbar; siehe docs/public_api.md.
# Zugriff erfolgt ueber Bearer-Tokens, die im Dashboard unter
# "Verwaltung -> API-Tokens" angelegt werden -- hier ist nichts zu setzen.
#
# Gleichzeitige Agentenlaeufe pro evaluation-Prozess. Das LLM-Backend teilt
# sich mit dem interaktiven Chat: hoeher heisst, dass API-Last die Oberflaeche
# ausbremst.
API_JOB_CONCURRENCY=2
# Zeitlimit pro Lauf in Sekunden. Ohne Limit blockiert ein haengendes LLM
# dauerhaft einen Bearbeitungsplatz.
API_JOB_TIMEOUT_S=900
# Wie oft der Worker nachsieht, ob eine andere Replica einen Job eingestellt hat.
API_JOB_POLL_INTERVAL_S=5
# Wie viele frueheren Runden einer Session als Verlauf nachgeladen werden,
# wenn der Client keinen eigenen mitschickt.
API_JOB_HISTORY_TURNS=10
# Access-Control-Allow-Origin fuer /api/v1. Bearer-Tokens werden vom Browser
# nicht automatisch mitgeschickt, deshalb ist "*" hier unkritisch.
API_CORS_ORIGIN=*

# ── Logging ──────────────────────────────────────────────────
# Log-Level fuer alle Services: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── Use-Case-Transfer (Export/Import) ────────────────────────
# Export-Archive und Import-Uploads liegen hier im evaluation-Container, bis
# sie heruntergeladen/importiert sind (nach 24 h geloescht). Braucht Platz fuer
# den groessten Use Case (Vektoren + Originaldateien). Siehe
# docs/use_case_transfer.md
# TRANSFER_DIR=/tmp/kermit-transfer

# ── Skill-Plugin-Layer (ausfuehrbare Skill-Funktionen) ───────
# Skills koennen eine Code-Datei (.py oder .js) mitbringen, deren Funktionen
# das LLM als `skillname.funktion(...)` in der Antwort aufruft. Die Ausfuehrung
# laeuft in einem eigenen, kurzlebigen Docker-Container. Siehe
# docs/skill_functions_developer.md und docs/skill_functions_architecture.md.
#
# Master-Schalter im evaluation-Service. "false" heisst: der Parser laeuft
# nicht und es startet kein Container -- richtig fuer ein Deployment ohne
# sandbox-Service.
SKILL_FUNCTIONS_ENABLED=true
# Adresse des sandbox-Service (nur intern erreichbar).
SANDBOX_SERVICE_URL=http://sandbox:8007
# Gemeinsames Geheimnis zwischen evaluation und sandbox. Ohne dieses Token
# koennte jeder Prozess im internen Netz beliebigen Code ausfuehren lassen --
# in Produktion IMMER setzen.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SANDBOX_TOKEN=

# Image, das pro Funktionsaufruf gestartet wird (`make skill-runner` baut es).
SKILL_RUNNER_IMAGE=kermit-skill-runner:latest
# Internes Docker-Netz fuer Runner mit Domain-Allowlist. `internal: true`:
# ohne Route nach aussen, einziger erreichbarer Peer ist der Egress-Proxy.
SKILL_EGRESS_NETWORK=kermit_skill_egress
SKILL_PROXY_HOST=sandbox
SKILL_PROXY_PORT=8888

# Obergrenzen pro Ausfuehrung. Eine Funktion darf ihre eigenen Werte setzen,
# aber niemals ueber diese hinaus.
SKILL_MAX_TIMEOUT_MS=30000
SKILL_MAX_MEMORY_MB=512
SKILL_CPU_QUOTA=0.5
SKILL_PIDS_LIMIT=64
# Gleichzeitig laufende Runner-Container. Jeder Aufruf ist ein Prozess plus
# ein Container; ohne Grenze wird ein Antwort-Ansturm zum Ausfall.
SKILL_MAX_CONCURRENT=4
# Wie lange eine Freigabe-Rueckfrage im Chat auf eine Antwort wartet. Ohne
# Antwort gilt sie als abgelehnt -- die Funktion laeuft nicht.
SKILL_PERMISSION_TIMEOUT_S=120

# ── Antwortzeit: Reranking ───────────────────────────────────
# Der Cross-Encoder ist auf CPU der teuerste Einzelschritt einer Anfrage.
# Gemessen auf dieser Plattform (bge-reranker-v2-m3, 12 Threads, CPU):
#
#   Kandidaten   pro Suche   bei 3 Suchen
#          25     11,1 s        33,2 s     <- Default
#          20      8,6 s        25,7 s
#          16      6,6 s        19,8 s
#          12      5,4 s        16,3 s
#           8      3,3 s         9,9 s
#
# Der Agent sieht am Ende nur die besten 7 Chunks. Alles, was darueber
# hinaus bewertet wird, ist bezahlte und weggeworfene Rechenzeit — der
# Nutzen sinkt mit jedem weiteren Kandidaten, die Kosten nicht.
# 16 ist ein guter Kompromiss; darunter kann ein von der Hybrid-Suche
# schlecht platzierter Treffer nicht mehr nach oben gerankt werden.
RERANK_CANDIDATES=25
# Wie viele der bewerteten Kandidaten weitergereicht werden (vor Dedup).
RERANK_TOP_N=15
# Trunkierung pro (Query, Chunk)-Paar. Chunks sind per Default ~256 Tokens,
# 512 bezahlt also ueberwiegend Padding. Kleiner als die Chunk-Groesse
# schneidet Belegtext ab.
RERANKER_MAX_LENGTH=512
# Reranker ganz abschalten: spart die komplette Zeit oben, kostet aber
# Ranking-Qualitaet — die Reihenfolge kommt dann nur aus der Hybrid-Fusion.
RERANKER_ENABLED=true
