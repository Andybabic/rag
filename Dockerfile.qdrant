# Qdrant-Wrapper fuer Hosting (Coolify-kompatibel).
#
# Coolify (und manuelle Bind-Mounts) mappen oft /qdrant oder /qdrant/storage
# und verdecken damit entrypoint.sh + Binary im offiziellen Image.
# Runtime liegt deshalb unter /opt/qdrant-runtime; nur /var/lib/qdrant ist
# der persistente Datenpfad (siehe docker-compose.build.yml).
FROM qdrant/qdrant:v1.9.7

USER root
RUN cp -a /qdrant /opt/qdrant-runtime

WORKDIR /opt/qdrant-runtime

ENV QDRANT__STORAGE__STORAGE_PATH=/var/lib/qdrant \
    QDRANT_INIT_FILE_PATH=/var/lib/qdrant/.qdrant-initialized

EXPOSE 6333 6334

CMD ["./entrypoint.sh"]
